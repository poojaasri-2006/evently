# Local database; on Vercel use your hosted PostgreSQL pooled connection string.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/event_vendor_management?schema=public"
JWT_SECRET="replace-with-a-long-random-secret"
PORT=5000
CLIENT_URL=http://localhost:5173
EVENT_TIMEZONE=Asia/Kolkata

# Required on Vercel. Use the Redis TCP/TLS URL, not its REST API URL.
# REDIS_URL=rediss://default:password@redis-host:6379
# Attach a PUBLIC Vercel Blob store; Vercel supplies this token.
# BLOB_READ_WRITE_TOKEN=your-vercel-blob-token
